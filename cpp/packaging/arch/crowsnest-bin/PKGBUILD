# Maintainer: Crowsnest <noreply@example.com>
# Prebuilt binary for AUR (package name: crowsnest-bin). Repackages the
# official portable bundle (Qt 6 is bundled, no Qt needed on the host).
# Publish: bash cpp/packaging/arch/publish-aur.sh crowsnest-bin
pkgname=crowsnest-bin
pkgver=0.6.0
pkgrel=1
pkgdesc="Compact always-on-top HUD for focused-process and infra status (prebuilt)"
arch=('x86_64')
url="https://github.com/codeafridi/Crowsnest"
license=('MIT')
depends=('glibc' 'hicolor-icon-theme')
optdepends=('xdotool: focused-window detection on X11/XWayland sessions'
            'docker: Docker container health badges'
            'kubectl: Kubernetes workload health badges')
provides=('crowsnest')
conflicts=('crowsnest' 'syspeek')
replaces=('syspeek')
# Prebuilt binaries must not be stripped (they ship their own bundled Qt).
options=('!strip' '!debug')
source=("crowsnest-portable-$pkgver.tar.gz::https://github.com/codeafridi/Crowsnest/releases/download/v$pkgver/crowsnest-portable.tar.gz"
        "crowsnest.svg::https://raw.githubusercontent.com/codeafridi/Crowsnest/v$pkgver/cpp/packaging/icons/crowsnest.svg"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/codeafridi/Crowsnest/v$pkgver/LICENSE")
# Checksums refreshed for v0.6.0 (publish .SRCINFO alongside). To refresh
# locally on Arch: `updpkgsums && makepkg --printsrcinfo > .SRCINFO`.
sha256sums=('084d56d365a5747c46a8bcf048690a10aa1870da659635abe62a158e983a2bc5'
            'baf84f64c63c501ac8f22e2f2853152b4b6ddcbb18b06d24e08ccc60dbc4cc16'
            'c0768673b1f931dbac895284d725a7e9a55c1fbe9328df52d9a800fa49aec55c')

package() {
    install -dm0755 "$pkgdir/opt/crowsnest"
    # Bundle layout: crowsnest, lib/, plugins/, run.sh, bridge/, README.md.
    # run.sh sets LD_LIBRARY_PATH/QT_PLUGIN_PATH relative to itself.
    tar xzf "$srcdir/crowsnest-portable-$pkgver.tar.gz" -C "$pkgdir/opt/crowsnest"
    chmod +x "$pkgdir/opt/crowsnest/run.sh" "$pkgdir/opt/crowsnest/crowsnest"
    install -dm0755 "$pkgdir/usr/bin"
    ln -s /opt/crowsnest/run.sh "$pkgdir/usr/bin/crowsnest"
    cat > crowsnest.service <<'EOF'
[Unit]
Description=Crowsnest
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/crowsnest
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
EOF
    install -Dm0644 crowsnest.service \
        "$pkgdir/usr/lib/systemd/user/crowsnest.service"
    cat > crowsnest.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Crowsnest
Comment=Compact on-screen focused-process monitor
Exec=/usr/bin/crowsnest
Icon=crowsnest
Terminal=false
Categories=Utility;System;Monitor;
EOF
    install -Dm0644 crowsnest.desktop \
        "$pkgdir/usr/share/applications/crowsnest.desktop"
    install -Dm0644 "$srcdir/crowsnest.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/crowsnest.svg"
    install -Dm0644 "$srcdir/LICENSE-$pkgver" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 "$pkgdir/opt/crowsnest/README.md" \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
